@startuml data_structures
title Key Data Structures

skinparam defaultFontSize 12

class set_point_generator {
    + float final_target
    + float max_speed_rad_s
    + float current_setpoint
    --
    + set_point_generator_init(target, speed)
    + set_point_generator_update(dt) : float
}

class control_loop {
    + double Kp
    + double Ki
    + double Kd
    + double integral_err
    + double prev_err
    --
    + control_loop_init(Kp, Ki, Kd)
    + control_loop_compute(setpoint, measurement, dt) : float
}

class actuator {
    + state_space_model *physical_plant
    --
    + actuator_write_voltage(volts)
}

class sensor {
    + state_space_model *physical_plant
    --
    + sensor_read_position() : float
    + sensor_read_velocity() : float
}

class state_space_model {
    + float x[]  ' state vector
    + float u    ' input (voltage)
    + float y    ' output (position)
    --
    + state_space_model_init()
    + state_space_model_step(dt)
}

class motion_control_event_handler {
    + int (*handler)(int)
}

class motion_control_service {
    + const char *name        ' MQTT topic
    + func(void *data) : int
    + service_descriptor[]
    + service_descriptor_size
}

class mqtt_client_ctx <<singleton>> {
    + broker: sockaddr_storage
    + rx_buf[512]
    + tx_buf[512]
    + keepalive = 60
    + clean_session = 1
    --
    + mqtt_evt_handler()
    + subscribe()
    + publish()
}

actuator --> state_space_model : writes u
sensor --> state_space_model : reads y, x[1]
control_loop ..> set_point_generator : uses desired_pos
control_loop ..> actuator : writes command_volts
control_loop ..> sensor : reads actual_pos

mqtt_client_ctx ..> motion_control_service : listener dispatches\nby topic name
motion_control_service ..> motion_control_event_handler : posts event →\ndispatched by events thread

@enduml

