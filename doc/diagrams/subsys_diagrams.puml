@startuml sequence_set_position
title Sequence — MQTT "set_x" command → PID setpoint update

skinparam defaultFontSize 12

participant "MQTT Broker" as broker
participant "mqtt_client\n(pubsub_thread)" as mqtt
participant "motion_control_\nservice_listener" as mc_listener
participant "set_sync_axis_0\n_position()" as mc_svc
participant "motion_control_\nevents_thread" as mc_evt_thread
participant "set_position_\nevent_handler()" as cl_evt
participant "control_loop_\nthread" as cl_thread

broker -> mqtt : PUBLISH\ntopic: motion_control/commands/set_x\npayload: {"position": 1000}
activate mqtt

mqtt -> mqtt : mqtt_evt_handler(MQTT_EVT_PUBLISH)
mqtt -> mqtt : handle_publish()\n→ mqtt_client_listener(topic, payload)
mqtt -> mc_listener : motion_control_service_listener\n(topic, payload)
activate mc_listener

mc_listener -> mc_listener : STRUCT_SECTION_FOREACH — match "set_x"
mc_listener -> mc_listener : json_obj_parse(payload)\n→ set_sync_axis_0_position_data {position=1000}
mc_listener -> mc_svc : service->func(&service_data)
activate mc_svc

mc_svc -> mc_evt_thread : motion_control_event_post\n(EVENT_SET_X, RX, 1000)\n→ k_msgq_put()
deactivate mc_svc
deactivate mc_listener
deactivate mqtt

activate mc_evt_thread
mc_evt_thread -> mc_evt_thread : k_msgq_get() unblocks
mc_evt_thread -> cl_evt : rx_event_handlers[SET_X].handler(1000)
deactivate mc_evt_thread

activate cl_evt
cl_evt -> cl_thread : control_loop_set_target_setpoint(1000)
activate cl_thread

cl_thread -> cl_thread : k_sem_take(set_point_sem)\nset_point_generator_init(&trajectory, 1000, 250.0)\nk_sem_give(set_point_sem)
deactivate cl_thread
deactivate cl_evt

note over cl_thread
  Next control_loop_thread tick:
  desired_pos ramps toward 1000 rad
  PID computes new command_volts
  actuator_write_voltage() → motor.u
end note

@enduml

' ─────────────────────────────────────────────────────────────────────────────

@startuml control_loop_activity
title Activity — control_loop_thread (execution order per control_loop.c)

skinparam defaultFontSize 12

start

:state_space_model_init(&motor);
:motor_driver.physical_plant = &motor;
:encoder.physical_plant     = &motor;
note right: both share the same\nstate_space_model instance
:control_loop_init(&pid, Kp=0.5, Ki=0.01, Kd=0.005);
note right: dt_ctrl = 1ms  dt_sim = 1µs\nsim_steps = dt_ctrl / dt_sim = 1000

repeat

    :① set_point_generator_update(&trajectory, dt_ctrl)
    → desired_pos;
    note right: ramps current_setpoint toward\nfinal_target at max_speed_rad_s\nprotected by set_point_sem

    :② sensor_read_position(&encoder)
    → actual_pos = motor.y;
    note right: reads output of state_space_model\nfrom **previous** tick

    :③ control_loop_compute(&pid, desired_pos, actual_pos, dt_ctrl)
    → command_volts;
    note right: PID: Kp·e + Ki·∫e·dt + Kd·Δe/dt

    :④ actuator_write_voltage(&motor_driver, command_volts)
    → motor.u = clamp(volts, -24V, +24V);

    :⑤ inner sim loop × 1000 iterations;
    note right: **lib/plant: state_space_model_step(&motor, 1µs)**\ndx[i] = A[i][j]·x[j] + B[i]·u\nx[i] += dx[i]·dt\ny = C·x  →  y = x[0]  (position)\n─────────────────────────\nx[0] position (rad)\nx[1] velocity (rad/s)\nx[2] current  (A)\nA[1][1]=-b/J  A[1][2]=K/J\nA[2][1]=-K/L  A[2][2]=-R/L\nB[2]=1/L   C[0]=1\n1000 × 1µs = 1ms of physics

    :⑥ sensor_read_velocity(&encoder)
    → actual_vel = motor.x[1];
    note right: reads velocity state **after**\ninner sim loop has run

    :log_control_loop_status() every 1000 ticks;
    note right: only logs when logging_tick % 1000 == 0

repeat while (for ever) is
    note right: no k_sleep — busy loop\nthread yields only via Zephyr\npreemption or cooperative yield

stop

@enduml

