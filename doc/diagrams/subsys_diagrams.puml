@startuml component_overview

header
<size:20><b>Created By: Jilay Sandeep Pandya</b></size>
endheader

title Component Overview — mqtt_client / motion_control / control_loop

skinparam componentStyle rectangle
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam headerFontSize 20
skinparam titleHorizontalAlignment left

cloud "MQTT Broker\n(169.254.191.55:1883)" as broker

package "mqtt_client subsys" {
    component [mqtt_client.c\n(pubsub thread)] as mqtt
    component [mqtt_evt_handler] as evthandler
    interface "mqtt_client_listener_t\ncallback" as listener_iface
}

package "motion_control subsys" {
    component [motion_control_services_register.c\nmotion_control_service_listener()] as mc_listener
    component [motion_control_services.c\nset_sync_axis_0_position()\nget_sync_axis_0_position()] as mc_services
    component [motion_control_events.c\n(events thread)] as mc_events
    queue "K_MSGQ\nmotion_control_events_queue" as msgq
    frame "Event Handler Registry" as handler_registry {
        artifact "RX [SET_X] → set_position_event_handler()" as rx_set_x
        artifact "RX [GET_X] → (none registered)" as rx_get_x
        artifact "TX [SET_X] → (none registered)" as tx_set_x
    }
}

package "control_loop subsys" {

    collections "control_loop_event_handlers.c\n<<SYS_INIT>>\nset_position_event_handler()" as cl_evthandler

    package "control_loop.c  (control_loop_thread — busy loop, no sleep)" {
        component "① set_point_generator_update(dt_ctrl)\n   reads/writes: trajectory.current_setpoint\n   protected by K_SEM set_point_sem\n   → desired_pos" as step1
        component "② sensor_read_position(&encoder)\n   reads: encoder.physical_plant->y  (= motor.y)\n   → actual_pos  [prev-tick plant output]" as step2
        component "③ control_loop_compute(&pid, desired_pos, actual_pos, dt_ctrl)\n   PID: Kp·e + Ki·∫e·dt + Kd·Δe/dt\n   → command_volts" as step3
        component "④ actuator_write_voltage(&motor_driver, command_volts)\n   clamp to [-24V, +24V]\n   writes: motor_driver.physical_plant->u  (= motor.u)" as step4
        component "⑤ state_space_model_step(&motor, dt_sim) × 1000\n   advances x[0..2], recomputes y = C·x\n   [1000 × 1µs = 1ms of physics]" as step5
        component "⑥ sensor_read_velocity(&encoder)\n   reads: encoder.physical_plant->x[1]  (velocity)\n   → actual_vel  [post-sim new state]" as step6
    }

    package "lib/plant  (state_space_bldc_motor.c)" as plant_lib {
        database "state_space_model\n──────────────────\nx[0] : position  (rad)\nx[1] : velocity  (rad/s)\nx[2] : current   (A)\nu    : voltage input (V)\ny    : position output = C·x\n──────────────────\nA, B, C : motor matrices\n  J=3.2284e-6  b=3.5077e-6\n  K=0.0274  R=4.0  L=2.75e-6" as ssm
    }
}

broker --> mqtt : TCP/MQTT subscribe\n"motion_control/commands/#"
mqtt --> evthandler : mqtt_evt_handler()
evthandler --> listener_iface : mqtt_client_listener(topic, payload)
listener_iface --> mc_listener : motion_control_service_listener()
mc_listener --> mc_services : matches topic →\ncalls service->func()
mc_services --> mc_events : motion_control_event_post\n(EVENT_SET_X, RX, position)
mc_events --> msgq : k_msgq_put()
msgq --> mc_events : k_msgq_get()\n(events thread unblocks)
mc_events --> handler_registry : lookup rx_event_handlers[SET_X]
handler_registry --> cl_evthandler : call handler(position)
cl_evthandler --> step1 : control_loop_set_target_setpoint(position)\n

' sequential flow inside control_loop_thread
step1 -down-> step2
step2 -down-> step3
step3 -down-> step4
step4 -down-> step5
step5 -down-> step6
step6 -up-> step1 : next tick

' interactions with plant model
step2 ..> ssm : read  motor.y\n(position output)
step4 ..> ssm : write motor.u\n(voltage input)
step5 ..> ssm : state_space_model_step(dt_sim)\ndx = A·x + B·u\nx += dx·dt\ny  = C·x
step6 ..> ssm : read  motor.x[1]\n(velocity state)

' SYS_INIT registration at boot
cl_evthandler -[dashed]-> handler_registry : <<SYS_INIT>>\nmotion_control_add_event_handler\n(SET_X, RX, set_position_event_handler)

mqtt <-- broker : PUBLISH "zephyr/sensors/temperature"

@enduml

